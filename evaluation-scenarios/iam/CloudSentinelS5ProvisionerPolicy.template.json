{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyntheticS3ObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectTagging", "s3:PutObject", "s3:PutObjectTagging", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::cloudsentinel-eval-*/*"
    },
    {
      "Sid": "S5MetadataOnlySecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-2:*:secret:cloudsentinel-eval-*"
    },
    {
      "Sid": "S5InstanceProfileOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::*:instance-profile/cloudsentinel-eval-*"
    },
    {
      "Sid": "S5PassTestRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/cloudsentinel-eval-*",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "CreatePrivateS5Subnet",
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": "arn:aws:ec2:ap-south-2:*:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:ResourceTag/Project": "CloudSentinel",
          "aws:ResourceTag/Environment": "Evaluation"
        }
      }
    },
    {
      "Sid": "CreateTaggedS5Subnet",
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": "arn:aws:ec2:ap-south-2:*:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:RequestTag/Project": "CloudSentinel",
          "aws:RequestTag/Environment": "Evaluation",
          "aws:RequestTag/Owner": "Harshith"
        }
      }
    },
    {
      "Sid": "UseAmazonOwnedImageForS5",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-south-2::image/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "ec2:Owner": "amazon"
        }
      }
    },
    {
      "Sid": "UseTaggedPrivateS5NetworkOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-south-2:*:subnet/*",
        "arn:aws:ec2:ap-south-2:*:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:ResourceTag/Project": "CloudSentinel",
          "aws:ResourceTag/Environment": "Evaluation",
          "aws:ResourceTag/Scenario": "S5"
        }
      }
    },
    {
      "Sid": "CreateTaggedS5InstanceAndVolumeOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-south-2:*:instance/*",
        "arn:aws:ec2:ap-south-2:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:RequestTag/Project": "CloudSentinel",
          "aws:RequestTag/Environment": "Evaluation",
          "aws:RequestTag/Owner": "Harshith"
        }
      }
    },
    {
      "Sid": "CreateS5NetworkInterfaceOnlyDuringLaunch",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-south-2:*:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    },
    {
      "Sid": "ManageTaggedS5Compute",
      "Effect": "Allow",
      "Action": ["ec2:DeleteSubnet", "ec2:TerminateInstances"],
      "Resource": [
        "arn:aws:ec2:ap-south-2:*:instance/*",
        "arn:aws:ec2:ap-south-2:*:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:ResourceTag/Project": "CloudSentinel",
          "aws:ResourceTag/Environment": "Evaluation"
        }
      }
    },
    {
      "Sid": "TagNewS5ComputeResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-south-2:*:instance/*",
        "arn:aws:ec2:ap-south-2:*:network-interface/*",
        "arn:aws:ec2:ap-south-2:*:subnet/*",
        "arn:aws:ec2:ap-south-2:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": ["CreateSubnet", "RunInstances"],
          "aws:RequestedRegion": "ap-south-2",
          "aws:RequestTag/Project": "CloudSentinel",
          "aws:RequestTag/Environment": "Evaluation",
          "aws:RequestTag/Owner": "Harshith"
        }
      }
    },
    {
      "Sid": "DescribeS5ComputeResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-2"}}
    }
  ]
}
