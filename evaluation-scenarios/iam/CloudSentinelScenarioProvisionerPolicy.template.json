{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyCaller",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "S3EvaluationBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::cloudsentinel-eval-*"
    },
    {
      "Sid": "TestRoleOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::*:role/cloudsentinel-eval-*"
    },
    {
      "Sid": "CreateTaggedEvaluationNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:RequestTag/Project": "CloudSentinel",
          "aws:RequestTag/Environment": "Evaluation",
          "aws:RequestTag/Owner": "Harshith"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment",
            "Owner",
            "CleanupDate",
            "ManagedBy",
            "Scenario",
            "SafetyBoundary",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "TagNewEvaluationNetworkResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-south-2:*:vpc/*",
        "arn:aws:ec2:ap-south-2:*:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSecurityGroup"
          ],
          "aws:RequestedRegion": "ap-south-2",
          "aws:RequestTag/Project": "CloudSentinel",
          "aws:RequestTag/Environment": "Evaluation",
          "aws:RequestTag/Owner": "Harshith"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment",
            "Owner",
            "CleanupDate",
            "ManagedBy",
            "Scenario",
            "SafetyBoundary",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "ManageTaggedEvaluationNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2",
          "aws:ResourceTag/Project": "CloudSentinel",
          "aws:ResourceTag/Environment": "Evaluation"
        }
      }
    },
    {
      "Sid": "DescribeEvaluationNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcs",
        "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-2"
        }
      }
    }
  ]
}
