# Copy this file to terraform.tfvars locally. Do not commit terraform.tfvars.
aws_region      = "ap-south-2"
aws_profile     = "cloudsentinel-provisioner"
owner           = "Harshith"
cleanup_date    = "REPLACE_WITH_YYYY-MM-DD"
scenario_suffix                      = "lab"
enable_s1_public_control_scenario     = false
enable_s2_bucket_wildcard_scenario    = false
enable_s4_disabled_trail_scenario      = false
