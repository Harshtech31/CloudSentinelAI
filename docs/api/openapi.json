  "components": {
    "schemas": {
      "CloudProvider": {
        "type": "string",
        "enum": [
          "aws",
          "gcp",
          "azure"
        ],
        "title": "CloudProvider",
        "description": "Supported cloud infrastructure providers."
      },
      "CytoscapeEdge": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CytoscapeEdgeData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "CytoscapeEdge",
        "description": "Cytoscape.js edge element."
      },
      "CytoscapeEdgeData": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique edge ID",
            "example": "edge_0_node_internet_node_i_0123"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source node ID",
            "example": "node_internet"
          },
          "target": {
            "type": "string",
            "title": "Target",
            "description": "Target node ID",
            "example": "node_i_0123"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Relationship edge type",
            "example": "EXPOSES_PORT"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type"
        ],
        "title": "CytoscapeEdgeData",
        "description": "Data payload for a Cytoscape.js graph edge."
      },
      "CytoscapeElements": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/CytoscapeNode"
            },
            "type": "array",
            "title": "Nodes",
            "description": "Graph nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/CytoscapeEdge"
            },
            "type": "array",
            "title": "Edges",
            "description": "Graph edges"
          }
        },
        "type": "object",
        "title": "CytoscapeElements",
        "description": "Combined elements container for Cytoscape.js canvas."
      },
      "CytoscapeNode": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CytoscapeNodeData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "CytoscapeNode",
        "description": "Cytoscape.js node element."
      },
      "CytoscapeNodeData": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique node ID",
            "example": "node_i_0123"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Display label",
            "example": "Web-Server-EC2"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Asset node type",
            "example": "EC2_INSTANCE"
          },
          "arn": {
            "type": "string",
            "title": "Arn",
            "description": "Resource ARN",
            "default": "",
            "example": "arn:aws:ec2:us-east-1:123456789012:instance/i-0123"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "description": "Asset cloud region",
            "default": "",
            "example": "us-east-1"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "title": "CytoscapeNodeData",
        "description": "Data payload for a Cytoscape.js graph node."
      },
      "DashboardSummaryResponse": {
        "properties": {
          "security_score": {
            "type": "number",
            "title": "Security Score",
            "description": "Overall cloud security score (0-100)",
            "example": 87.5
          },
          "scanned_resources": {
            "type": "integer",
            "title": "Scanned Resources",
            "description": "Total cloud assets scanned",
            "example": 142
          },
          "total_findings": {
            "type": "integer",
            "title": "Total Findings",
            "description": "Total active misconfigurations",
            "example": 15
          },
          "critical_findings": {
            "type": "integer",
            "title": "Critical Findings",
            "description": "Critical severity findings count",
            "example": 2
          },
          "attack_paths_identified": {
            "type": "integer",
            "title": "Attack Paths Identified",
            "description": "Total exploitable attack chains detected",
            "example": 3
          }
        },
        "type": "object",
        "required": [
          "security_score",
          "scanned_resources",
          "total_findings",
          "critical_findings",
          "attack_paths_identified"
        ],
        "title": "DashboardSummaryResponse",
        "description": "Executive security dashboard posture summary."
      },
      "FindingListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total matching findings count",
            "example": 42
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Current page number",
            "default": 1,
            "example": 1
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "description": "Items per page",
            "default": 50,
            "example": 50
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            },
            "type": "array",
            "title": "Findings",
            "description": "List of findings"
          }
        },
        "type": "object",
        "required": [
          "total"
        ],
        "title": "FindingListResponse",
        "description": "Paginated list of findings."
      },
      "FindingResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique finding identifier",
            "example": "fnd_01j7b9"
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id",
            "description": "Associated scan identifier",
            "example": "scn_83f12a9c"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id",
            "description": "Identifier of the rule violated",
            "example": "AWS-IAM-001"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short finding summary",
            "example": "Root account MFA is disabled"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Detailed description of misconfiguration",
            "example": "The root account has console access enabled without multi-factor authentication."
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "description": "Vulnerability severity level",
            "example": "critical"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score",
            "description": "Calculated risk score (0.0 - 10.0)",
            "example": 9.5
          },
          "resource_type": {
            "type": "string",
            "title": "Resource Type",
            "description": "Cloud resource type",
            "example": "iam_user"
          },
          "resource_arn": {
            "type": "string",
            "title": "Resource Arn",
            "description": "Resource Amazon Resource Name or ID",
            "example": "arn:aws:iam::123456789012:root"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "description": "Cloud region of affected resource",
            "default": "global",
            "example": "us-east-1"
          },
          "remediation_guidance": {
            "type": "string",
            "title": "Remediation Guidance",
            "description": "Recommended remediation action",
