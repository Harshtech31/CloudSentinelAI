# ==============================================================================
# CloudSentinel AI — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="CloudSentinel AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-super-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=cloudsentinel
POSTGRES_PASSWORD=cloudsentinel_secure_pass
POSTGRES_DB=cloudsentinel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudsentinel:cloudsentinel_secure_pass@localhost:5432/cloudsentinel_db
DATABASE_SYNC_URL=postgresql+psycopg2://cloudsentinel:cloudsentinel_secure_pass@localhost:5432/cloudsentinel_db

# Neo4j Graph Database (Optional for Phase 2+)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# AWS Credentials for Scanner Engine (Optional - Can also be provided per scan)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# AI Explanation Engine
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AWS_BEDROCK_REGION=us-east-1

# Redis / Celery Task Queue (Optional for Phase 3+)
REDIS_URL=redis://redis:6379/0
